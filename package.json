{
  "name": "guess-the-thief",
  "version": "1.0.0",
  "description": "Real-time multiplayer social deduction game",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "start": "cd server && npm start",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "build": "cd client && npm run build",
    "progress": "node scripts/progress-check.js",
    "update-badges": "npm run progress && node scripts/update-readme-badges.js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "game",
    "multiplayer",
    "socket.io",
    "react",
    "social-deduction"
  ],
  "author": "Subhajit <subhajitlucky@github>",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true
  }
}
